<brls:Box
    highlightCornerRadius="12"
    padding="5">

    <brls:Box
        axis="row"
        width="320"
        alignItems="center">
        <!-- same contract as video_card.xml: BaseCardCell::getDefaultFocus()
             returns this box to limit the focus halo to the thumbnail.
             Fixed 16:9 (320x180): the thumbnail must keep its size even with no
             image — otherwise the Image (height only, width from the texture
             aspect) collapses to a thin vertical strip on backdrop-less items. -->
        <brls:Box
            id="video/card/pic_box"
            focusable="true"
            width="300"
            height="180"
            highlightCornerRadius="12"
            cornerRadius="8"
            backgroundColor="@theme/color/grey_1">

            <!-- placeholder icon behind the thumbnail (cf. video_card.xml);
                 pic_box carries the fixed 300x180 size so a missing thumbnail
                 (non-downloaded/greyed episode) keeps the box, icon and focus
                 halo instead of collapsing to a thin sliver -->
            <brls:Box
                positionType="absolute"
                positionTop="0"
                positionLeft="0"
                width="100%"
                height="100%"
                alignItems="center"
                justifyContent="center">
                <SVGImage
                    width="36"
                    height="36"
                    svg="@res/icon/ico-media.svg" />
            </brls:Box>

            <brls:Image
                id="video/card/picture"
                scalingType="fill"
                width="300"
                height="180"
                cornerRadius="8" />

            <!-- "downloaded" badge (top-left) -->
            <brls:Box
                id="video/card/badge/download"
                positionType="absolute"
                positionTop="8"
                positionLeft="8"
                visibility="gone"
                cornerRadius="6"
                paddingTop="4"
                paddingBottom="4"
                paddingLeft="4"
                paddingRight="4"
                backgroundColor="@theme/color/app">
                <SVGImage
                    width="16"
                    height="16"
                    svg="@res/icon/ico-download-light.svg" />
            </brls:Box>

            <brls:Box
                wireframe="false"
                positionType="absolute"
                positionBottom="0"
                visibility="gone"
                width="100%"
                height="2"
                backgroundColor="#353535">
                <brls:Rectangle
                    id="video/card/progress"
                    height="2"
                    width="50%"
                    color="@theme/color/app" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        axis="column"
        grow="1"
        marginLeft="20">
        <brls:Box
            axis="row"
            alignItems="center"
            margin="10">
            <brls:Label
                id="episode/card/name"
                grow="1"
                shrink="1"
                minWidth="0"
                singleLine="true"
                fontSize="18" />
            <brls:Box
                id="episode/card/watched"
                axis="row"
                alignItems="center"
                marginLeft="14"
                visibility="gone">
                <brls:Label
                    text="✓"
                    marginRight="5"
                    singleLine="true"
                    fontSize="18"
                    textColor="@theme/color/app" />
                <brls:Label
                    text="WATCHED"
                    singleLine="true"
                    fontSize="14"
                    textColor="@theme/color/app" />
            </brls:Box>
        </brls:Box>

        <TextBox
            id="episode/card/overview"
            grow="1"
            fontSize="15"
            maxRows="6"
            textColor="@theme/font/grey" />
    </brls:Box>

</brls:Box>
