+// Same conservative language hint used by the episode picker. A bare ITA token
+// is audio unless it is adjacent to an explicit subtitle marker; Italian words
+// require an audio/dub marker. This keeps SUB ITA out of the ITA AUDIO badge.
+bool movieSourceHasItalianAudio(const media::Media& m) {
+    std::string text = m.sourceName + " " + m.sourceTitle;
+    bool italianFlag = text.find(u8"🇮🇹") != std::string::npos;
+
+    std::vector<std::string> tokens;
+    std::string token;
+    auto flush = [&]() {
+        if (!token.empty()) {
+            tokens.push_back(token);
+            token.clear();
+        }
+    };
+    for (unsigned char c : text) {
+        if (c >= 'A' && c <= 'Z') c = (unsigned char)(c - 'A' + 'a');
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))
+            token.push_back((char)c);
+        else
+            flush();
+    }
+    flush();
+
+    auto isSubtitle = [](const std::string& t) {
+        return t == "sub" || t == "subs" || t == "subtitle" || t == "subtitles" || t == "subbed";
+    };
+    auto isAudio = [](const std::string& t) {
+        return t == "audio" || t == "dub" || t == "dubbed" || t == "dual" || t == "multi";
+    };
+    bool hasSubtitleMarker = false;
+    for (size_t i = 0; i < tokens.size(); ++i) {
+        hasSubtitleMarker = hasSubtitleMarker || isSubtitle(tokens[i]);
+        bool nearSubtitle = (i > 0 && isSubtitle(tokens[i - 1])) ||
+                            (i + 1 < tokens.size() && isSubtitle(tokens[i + 1]));
+        if (tokens[i] == "ita" && !nearSubtitle) return true;
+        if ((tokens[i] == "italian" || tokens[i] == "italiano" || tokens[i] == "italiana") &&
+            !nearSubtitle &&
+            ((i > 0 && isAudio(tokens[i - 1])) || (i + 1 < tokens.size() && isAudio(tokens[i + 1]))))
+            return true;
+    }
+    return italianFlag && !hasSubtitleMarker;
+}
